# MEMORY - Persistent Knowledge (3 Tools)
# =============================================================================

MEMORY_TOOLS: List[Dict[str, Any]] = [
    {
        "name": "memory_store",
        "description": "Store knowledge/facts/decisions in persistent memory",
        "inputSchema": {
            "type": "object",
            "properties": {
                "content": {"type": "string", "description": "Content to store"},
