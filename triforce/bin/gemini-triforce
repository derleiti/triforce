#!/usr/bin/env bash
# gemini-triforce v2.0 — Gemini CLI mit TriForce API Keys
source "$(dirname "$0")/triforce-env.sh"

# Gemini nutzt GEMINI_API_KEY aus env (via triforce-env.sh geladen)
# Agent-spezifisches Config-Dir
export XDG_CONFIG_HOME="/home/zombie/triforce/config/agents/gemini"

_log_agent_start "gemini" "gemini-2.5-flash" "$@"
exec gemini "$@"
