#!/usr/bin/env bash
# codex-triforce v3.1 — persist HOME auth
source "$(dirname "$0")/triforce-env.sh"

# Auth aus persist-Volume (frisch kopiert von /home/zombie/.codex/)
export HOME=/opt/triforce/persist/cli-config/codex

# npm auto-update (24h Cooldown, non-blocking)
_auto_update_npm "@openai/codex"

DEFAULT_MODEL="${CODEX_MODEL:-gpt-5.4}"

HAS_MODEL=false
for arg in "$@"; do
  [[ "$arg" == "--model" || "$arg" == "-m" ]] && HAS_MODEL=true
done

if $HAS_MODEL; then
  _log_agent_start "codex" "custom" "$@"
  exec codex "$@"
else
  _log_agent_start "codex" "$DEFAULT_MODEL" "$@"
  exec codex --model "$DEFAULT_MODEL" "$@"
fi
