#!/usr/bin/env bash
# opencode-triforce v2.0 — OpenCode mit TriForce MCP + OpenRouter Fallback
source "$(dirname "$0")/triforce-env.sh"

# Default Model: OpenRouter Free (wenn kein -m angegeben)
DEFAULT_MODEL="${OPENCODE_MODEL:-openrouter/openai/gpt-oss-120b:free}"

# Prüfe ob -m/--model in den Args ist
HAS_MODEL=false
for arg in "$@"; do
  [[ "$arg" == "-m" || "$arg" == "--model" ]] && HAS_MODEL=true
done

if $HAS_MODEL; then
  _log_agent_start "opencode" "custom" "$@"
  exec opencode "$@"
else
  _log_agent_start "opencode" "$DEFAULT_MODEL" "$@"
  exec opencode -m "$DEFAULT_MODEL" "$@"
fi
