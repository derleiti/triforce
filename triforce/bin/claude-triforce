#!/usr/bin/env bash
# claude-triforce v3.0 — Claude Code mit Account-OAuth + npm auto-update
source "$(dirname "$0")/triforce-env.sh"

# npm auto-update (24h Cooldown, non-blocking)
_auto_update_npm "@anthropic-ai/claude-code"

DEFAULT_MODEL="${CLAUDE_MODEL:-sonnet}"

HAS_MODEL=false
for arg in "$@"; do
  [[ "$arg" == "--model" || "$arg" == "-m" ]] && HAS_MODEL=true
done

if $HAS_MODEL; then
  _log_agent_start "claude" "custom" "$@"
  exec claude "$@"
else
  _log_agent_start "claude" "$DEFAULT_MODEL" "$@"
  exec claude --model "$DEFAULT_MODEL" "$@"
fi
