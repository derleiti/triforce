# ============================================================================
# AILinux Mirror Configuration - OPTIMIZED
# ============================================================================
# Core: Ubuntu, KDE Neon, Docker, Wine, Steam, Chrome, Node, LibreOffice
# Dev: VS Code
# Gaming/AI/GPU: Kisak Mesa, NVIDIA CUDA, Container Toolkit, Graphics Drivers
# ============================================================================

# --- apt-mirror Settings ---
set base_path         /var/spool/apt-mirror
set mirror_path       $base_path/mirror
set skel_path         $base_path/skel
set var_path          $base_path/var
set postmirror_script $var_path/postmirror.sh
set defaultarch       amd64
set run_postmirror    1
set nthreads          50
set limit_rate        100m

# --- MIRRORED REPOS ---
deb [arch=amd64,i386,arm64] https://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
deb [arch=amd64,i386,amr64] https://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
deb [arch=amd64,i386,arm64] https://security.ubuntu.com/ubuntu resolute-security main restricted universe multiverse
deb [arch=amd64,i386.arm64] https://deb.nodesource.com/node_22.x nodistro main
deb [arch=amd64,i386,arm64] https://dl.google.com/linux/chrome/deb stable main
deb [arch=amd64,i386,arm64] https://dl.winehq.org/wine-builds/ubuntu resolute main
deb [arch=amd64,i386,arm64] https://download.docker.com/linux/ubuntu resolute stable
deb [arch=amd64,i386,arm64] https://ppa.launchpadcontent.net/cappelikan/ppa/ubuntu resolute main
deb [arch=amd64,i386,arm64] https://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu resolute main
deb [arch=amd64,i386,arm64] https://ppa.launchpadcontent.net/graphics-drivers/ppa/ubuntu resolute main
deb [arch=amd64,i386,arm64] https://ppa.launchpadcontent.net/libreoffice/ppa/ubuntu resolute main
deb [arch=amd64,i386,arm64] https://repo.steampowered.com/steam stable steam
deb [arch=amd64,i386,arm64] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64 /
deb [arch=amd64,i386,arm64] https://archive.neon.kde.org/stable resolute main
deb [arch=amd64,i386,arm64] https://hub.unity3d.com/linux/repos/deb/ stable main
deb [arch=amd64,i386,arm64] https://packages.microsoft.com/repos/code stable main
deb [arch=amd64,i386,arm64] https://downloads.cursor.com/aptrepo stable main
deb [arch=amd64,i386,arm64] https://windsurf-stable.codeiumdata.com/wVxQEIWkwPUEAGf3/apt stable main
deb [arch=amd64,i386,arn64] https://persistent.oaistatic.com/codex-app-prod/linux/deb  stable main

# ============================================================================
# Cleanup old/removed packages
# ============================================================================
clean https://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
clean https://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
clean https://security.ubuntu.com/ubuntu resolute-security main restricted universe multiverse
clean https://deb.nodesource.com/node_22.x nodistro main
clean https://dl.google.com/linux/chrome/deb stable main
clean https://dl.winehq.org/wine-builds/ubuntu resolute main
clean https://download.docker.com/linux/ubuntu resolute stable
clean https://ppa.launchpadcontent.net/cappelikan/ppa/ubuntu resolute main
clean https://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu resolute main
clean https://ppa.launchpadcontent.net/graphics-drivers/ppa/ubuntu resolute main
clean https://ppa.launchpadcontent.net/libreoffice/ppa/ubuntu resolute main
clean https://repo.steampowered.com/steam stable steam
clean https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64 /
clean https://archive.neon.kde.org/stable resolute main
clean https://hub.unity3d.com/linux/repos/deb/ stable main
clean https://packages.microsoft.com/repos/code stable main
clean https://downloads.cursor.com/aptrepo stable main
clean https://windsurf-stable.codeiumdata.com/wVxQEIWkwPUEAGf3/apt stable main
clean https://persistent.oaistatic.com/codex-app-prod/linux/deb  stable main
