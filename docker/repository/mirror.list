# ============================================================================
# AILinux Mirror Configuration - OPTIMIZED
# ============================================================================
# Core: Ubuntu, KDE Neon, Docker, Wine, Steam, Chrome, Node, LibreOffice
# Dev: VS Code
# Gaming/AI/GPU: Kisak Mesa, NVIDIA CUDA, Container Toolkit, Graphics Drivers
# ============================================================================

# --- apt-mirror Settings ---
set base_path         /var/spool/apt-mirror
set mirror_path       $base_path/mirror
set skel_path         $base_path/skel
set var_path          $base_path/var
set postmirror_script $var_path/postmirror.sh
set defaultarch       amd64
set run_postmirror    1
set nthreads          50
set limit_rate        100m

# ============================================================================
# Ubuntu 26.04 (Resolute) - ESSENTIAL ONLY
# ============================================================================

# --- Main Archive (amd64) ---
deb-amd64 http://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
deb-amd64 http://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
deb-amd64 http://security.ubuntu.com/ubuntu resolute-security main restricted universe multiverse
deb-arm64 http://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
deb-arm64 http://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
deb-arm64 http://security.ubuntu.com/ubuntu resolute-security main restricted universe multiverse

# --- i386 Support (for Wine, Steam, 32-bit compatibility) ---
deb-i386 http://archive.ubuntu.com/ubuntu resolute main restricted universe multiverse
deb-i386 http://archive.ubuntu.com/ubuntu resolute-updates main restricted universe multiverse
deb-i386 http://security.ubuntu.com/ubuntu resolute-security main restricted universe multiverse

# ============================================================================
# KDE Neon (User Edition)
# ============================================================================
# deb-amd64 http://archive.neon.kde.org/user noble main

# ============================================================================
# Google Chrome
# ============================================================================
deb-amd64 http://dl.google.com/linux/chrome/deb/ stable main

# ============================================================================
# WineHQ (amd64 + i386 for 32-bit Windows apps)
# ============================================================================
deb-amd64 https://dl.winehq.org/wine-builds/ubuntu/ resolute main

# ============================================================================
# Docker CE (Official)
# ============================================================================
deb-amd64 https://download.docker.com/linux/ubuntu resolute stable

# ============================================================================
# Steam (amd64 + i386 for gaming)
# ============================================================================
deb-amd64 http://repo.steampowered.com/steam/ stable steam
deb-i386 http://repo.steampowered.com/steam/ stable steam

# ============================================================================
# Node.js 22.x LTS (Jod)
# ============================================================================
deb-amd64 http://deb.nodesource.com/node_22.x nodistro main

# ============================================================================
# LibreOffice Fresh PPA
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/libreoffice/ppa/ubuntu resolute main

# ============================================================================
# Cappelikan - Mainline Linux Kernels
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/cappelikan/ppa/ubuntu resolute main

# ============================================================================
# DEV: Visual Studio Code (Microsoft Official)
# ============================================================================
deb-amd64 http://packages.microsoft.com/repos/code stable main

# ============================================================================
# GAMING: Lutris PPA (DISABLED - no Resolute publication)
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/lutris-team/lutris/ubuntu resolute main

# ============================================================================
# GAMING: Kisak Mesa (current Mesa for AMD/Intel, amd64 + i386)
# Do not enable Oibaf in parallel; its Resolute package indexes are empty.
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu resolute main
deb-i386 http://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu resolute main

# ============================================================================
# DRIVERS: NVIDIA Proprietary Drivers PPA
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/graphics-drivers/ppa/ubuntu resolute main
deb-i386 http://ppa.launchpadcontent.net/graphics-drivers/ppa/ubuntu resolute main

# ============================================================================
# AI/ML: NVIDIA CUDA Toolkit for Ubuntu 26.04
# ============================================================================
deb-amd64 https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64/ /

# ============================================================================
# AI/ML: NVIDIA Container Toolkit (Docker GPU Support)
# ============================================================================
deb-amd64 https://nvidia.github.io/libnvidia-container/stable/deb/amd64 /

# ============================================================================
# AI/ML: Intel oneAPI (CPU/GPU Compute, MKL, OpenVINO)
# ============================================================================
deb-amd64 https://apt.repos.intel.com/oneapi all main

# ============================================================================
# Anthropic Claude
# =============================================================================
deb-amd64 https://downloads.claude.ai/claude-desktop/apt/stable stable main

# ============================================================================
# Cleanup old/removed packages
# ============================================================================
clean http://archive.ubuntu.com/ubuntu
clean http://security.ubuntu.com/ubuntu
clean http://archive.neon.kde.org/user
clean http://dl.google.com/linux/chrome/deb/
clean https://dl.winehq.org/wine-builds/ubuntu/
clean https://download.docker.com/linux/ubuntu
clean http://repo.steampowered.com/steam/
clean https://deb.nodesource.com/node_22.x
clean http://ppa.launchpadcontent.net/libreoffice/ppa/ubuntu
clean http://ppa.launchpadcontent.net/cappelikan/ppa/ubuntu
clean https://packages.microsoft.com/repos/code
clean http://ppa.launchpadcontent.net/lutris-team/lutris/ubuntu
clean http://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu
clean http://ppa.launchpadcontent.net/graphics-drivers/ppa/ubuntu
clean https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64/
clean https://nvidia.github.io/libnvidia-container/stable/deb/amd64
clean https://apt.repos.intel.com/oneapi
