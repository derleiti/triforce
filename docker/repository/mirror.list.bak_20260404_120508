# ============================================================================
# AILinux Mirror Configuration - OPTIMIZED
# ============================================================================
# Core: Ubuntu, KDE Neon, Docker, Wine, Steam, Chrome, Node, LibreOffice
# Dev: VS Code, Lutris
# AI/GPU: NVIDIA CUDA, Container Toolkit, Intel oneAPI, Graphics Drivers
# ============================================================================

# --- apt-mirror Settings ---
set base_path         /var/spool/apt-mirror
set mirror_path       $base_path/mirror
set skel_path         $base_path/skel
set var_path          $base_path/var
set postmirror_script $var_path/postmirror.sh
set defaultarch       amd64
set run_postmirror    1
set nthreads          50
set limit_rate        100m

# ============================================================================
# Ubuntu 26.04 LTS (Racoon) - ESSENTIAL ONLY
# ============================================================================

# --- Main Archive (amd64) ---
deb-amd64 http://archive.ubuntu.com/ubuntu racoon main restricted universe multiverse
deb-amd64 http://archive.ubuntu.com/ubuntu racoon-updates main restricted universe multiverse

# --- Security Updates ---
deb-amd64 http://security.ubuntu.com/ubuntu racoon-security main restricted universe multiverse

# --- i386 Support DISABLED 2026-04-03: Wine/Steam have own i386 repos ---
deb-i386 http://archive.ubuntu.com/ubuntu racoon main restricted universe multiverse
deb-i386 http://archive.ubuntu.com/ubuntu racoon-updates main restricted universe multiverse
deb-i386 http://security.ubuntu.com/ubuntu racoon-security main restricted universe multiverse

# ============================================================================
# KDE Neon (User Edition)
# ============================================================================
#deb-amd64 http://archive.neon.kde.org/user racoon main

# ============================================================================
# Google Chrome
# ============================================================================
deb-amd64 http://dl.google.com/linux/chrome/deb/ stable main

# ============================================================================
# WineHQ (amd64 + i386 for 32-bit Windows apps)
# ============================================================================
deb-amd64 https://dl.winehq.org/wine-builds/ubuntu/ racoon main
deb-i386 https://dl.winehq.org/wine-builds/ubuntu/ racoon main

# ============================================================================
# Docker CE (Official)
# ============================================================================
deb-amd64 https://download.docker.com/linux/ubuntu racoon stable

# ============================================================================
# Steam (amd64 + i386 for gaming)
# ============================================================================
deb-amd64 http://repo.steampowered.com/steam/ stable steam
deb-i386 http://repo.steampowered.com/steam/ stable steam

# ============================================================================
# Node.js 22.x LTS (Jod)
# ============================================================================
deb-amd64 https://deb.nodesource.com/node_22.x nodistro main

# ============================================================================
# LibreOffice Fresh PPA
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/libreoffice/ppa/ubuntu racoon main

# ============================================================================
# Cappelikan - Mainline Linux Kernels
# ============================================================================
deb-amd64 http://ppa.launchpadcontent.net/cappelikan/ppa/ubuntu racoon main

# ============================================================================
# DEV: Visual Studio Code (Microsoft Official)
# ============================================================================
deb-amd64 https://packages.microsoft.com/repos/code stable main

# ============================================================================
# GAMING: Lutris PPA (DISABLED - no racoon support as of Dec 2025)
