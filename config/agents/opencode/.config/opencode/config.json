{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3-coder:free",
  "small_model": "openrouter/mistralai/mistral-small-3.1-24b-instruct:free",
  "username": "TriForce",
  "theme": "dracula",
  "autoupdate": "notify",
  "share": "manual",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "headers": {
          "HTTP-Referer": "https://ailinux.me",
          "X-Title": "TriForce Agent"
        }
      }
    },
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" }
    },
    "google": {
      "options": { "apiKey": "{env:GEMINI_API_KEY}" }
    },
    "groq": {
      "options": { "apiKey": "{env:GROQ_API_KEY}" }
    }
  },

  "mcp": {
    "triforce": {
      "type": "remote",
      "url": "http://localhost:9000/v1/mcp",
      "enabled": true
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "mcp": "allow"
  }
}
